<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="CITA255Ex.MainPage">

<ScrollView>
    <VerticalStackLayout>
            <Border Stroke="Black" 
                    StrokeThickness="10" 
                    WidthRequest="300" 
                    HeightRequest="550"
                    
            >
                <Grid RowDefinitions = "auto, auto, auto, auto"
                      ColumnDefinitions="auto, auto, auto, auto"
                      RowSpacing="5"
                      ColumnSpacing="10"
                      Padding="15"
                  
                >
                    <Label FontSize="30"
                           Text="Game Log"
                           HorizontalTextAlignment="Center"
                           FontAttributes="Bold"
                           Grid.Row="0"
                           Grid.Column="0"
                           Grid.ColumnSpan="2"
                              
                        >

                        </Label>

                        <Border Grid.Row="1" 
                            Grid.Column="0" 
                            Stroke="White"
                            StrokeThickness="2"
                            
                    >
                        <VerticalStackLayout 
                            
                        >
                            <CollectionView x:Name="gamesList">
                                <CollectionView.ItemTemplate>
                                    <DataTemplate>

                                        <Label Text="{Binding .}" FontSize="18" Padding="5"/>

                                    </DataTemplate>
                                </CollectionView.ItemTemplate>
                            </CollectionView>
                        </VerticalStackLayout>
                    </Border>


                    <Border Grid.Row="1" 
                            Grid.Column="1" 
                            Stroke="White" 
                            StrokeThickness="2"
                    >
                        <VerticalStackLayout 
                            
                        >
                            <CollectionView x:Name="timeList">
                                <CollectionView.ItemTemplate>
                                    <DataTemplate>

                                        <Label Text="{Binding .}" 
                                               FontSize="18" 
                                               Padding="5" 
                                               HorizontalTextAlignment="End"
                                               
                                        />

                                    </DataTemplate>
                                </CollectionView.ItemTemplate>
                            </CollectionView>
                        </VerticalStackLayout>
                    </Border>

                    <Button
                            Grid.ColumnSpan="2"
                            Grid.Row="2"
                            Text="Total Games and Hours"
                            Clicked="onTotalClicked"
                    >

                    </Button>



                    <Label Text="time"
                           x:Name="timeTotal"
                           FontSize="20"
                           Grid.Row="3"
                           Grid.Column="0"

                           
                    >


                    </Label>
                
                </Grid>
            </Border>
            


        </VerticalStackLayout>
</ScrollView>

</ContentPage>
