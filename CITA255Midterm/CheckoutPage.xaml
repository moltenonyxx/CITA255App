<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="CITA255Midterm.CheckoutPage"
             Title="CheckoutPage">
    <VerticalStackLayout>
        <Grid 
            RowDefinitions="auto, auto, auto"
            ColumnDefinitions="auto, auto, auto"
            Padding="15"
            RowSpacing="15"
            >
            <Label 
                Grid.Row="0"
                Grid.Column="0"
                Text="Checkout Page"
                Style="{StaticResource shopItems}"
                VerticalOptions="Center" 
                FontSize="40"
                FontAttributes="Bold"
            />
            <CollectionView x:Name="CheckoutView"
                            Grid.Row="1"
                            Grid.Column="0">

                <CollectionView.ItemTemplate>
                    <DataTemplate>
                        <Label Text="{Binding .}"
                               Style="{StaticResource checkoutItems}"/>
                    </DataTemplate>
                </CollectionView.ItemTemplate>

                <CollectionView.EmptyView>
                    <Label Text="Nothing packed yet."
                           Style="{StaticResource breakPrice}" />
                </CollectionView.EmptyView>

            </CollectionView>

        </Grid>
        <Label
            x:Name="totalNum"
            Text="Total: $0.00"
            TextColor="#eb6123"
            VerticalTextAlignment="End"
            HorizontalTextAlignment="End"
            Padding="10"
            FontSize="20"
        />
        <Button
            Text="TOTAL"
            BackgroundColor="CadetBlue"
            WidthRequest="150"
            HorizontalOptions="End"
            Clicked="Total"
            />

    </VerticalStackLayout>
</ContentPage>