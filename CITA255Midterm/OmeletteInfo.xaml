<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="CITA255Midterm.OmeletteInfo"
             Title="">
    <VerticalStackLayout>
        <Grid 
            RowDefinitions="Auto, Auto, auto, auto, auto"
            ColumnDefinitions="Auto, auto, auto"
            Padding="10"
            RowSpacing="5"
            ColumnSpacing="15"
            >
            <Image
                Grid.Row="0"
                Grid.Column="0"
                Source="omelette.webp"
                HeightRequest="150"
                />
            <Label
                Grid.Row="1"
                Grid.Column="0"
                Text="Omelette"
                Style="{StaticResource breakTitle}" 
            />
            <Label
                Grid.Row="1"
                Grid.Column="1"
                Text="$8.99"
                Style="{StaticResource breakPrice}"
            />
            <Label
                Grid.Row="2"
                Grid.Column="0"
                Text="Fluffy eggs folded around your choice of cheese and fillings(2) 
                come with a side of vegetables"
                Style="{StaticResource breakDesc}"
            />
            <Label
                Grid.Row="2"
                Grid.Column="1"
                Text="In Stock"
                Style="{StaticResource inStock}"
                
            />
            <Entry
                Grid.Row="3"
                Grid.Column="0"
                x:Name="omeletteAmount"
                Placeholder="Enter how much you want.."
                MaximumWidthRequest="250"
            />
            <Button 
                Grid.Row="3"
                Grid.Column="1"
                Text="Add to Cart"
                Clicked="omeletteCart"
                WidthRequest="250"
                
            />
            <Label
                Grid.Row="4"
                Grid.Column="1"
                x:Name="omeletteResult"
                Text=""
                TextColor="Green"
                HorizontalTextAlignment="Center"
            />
            <Button
                Grid.Row="4"
                Grid.Column="0"
                Text="Back to Menu"
                WidthRequest="250"
                Clicked="OnBackClicked"
            />

        </Grid>
    </VerticalStackLayout>
</ContentPage>